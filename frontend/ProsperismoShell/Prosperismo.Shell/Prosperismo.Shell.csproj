<Project Sdk="Microsoft.NET.Sdk">

  <!-- Class library: the GUI is hosted by SharpEmu.CLI, which opens it when
       the executable is started without arguments. -->
  <PropertyGroup>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Required by the source-generated LibraryImport stubs in the linked
         controller readers below. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Dependency-free; provides the BuildInfo provenance shown in the
       title bar. -->
  <ItemGroup>
    <!-- The GUI owns the native presentation control while each game runs in
         an isolated emulator process. -->
    <ProjectReference Include="..\Prosperismo.Shell.Logging\Prosperismo.Shell.Logging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpEmu.Libs.Tests" />
    <!-- tools/shell-capture drives the live background off-screen so it can be
         graded against reference footage. It reads the same compositor the
         shell draws, rather than a second copy of it that could drift. -->
    <InternalsVisibleTo Include="ShellCapture" />
    <!-- tools/shell-shot renders the real controls off-screen. It has to drive
         their clocks itself, because a headless run has no wall clock for the
         controls' own timers to advance against. -->
    <InternalsVisibleTo Include="ShellShot" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shell button pictograms. Optional by design: deleting the directory is
         supported and ShellIcons falls back to the user's dump, then to its own
         glyphs. See LICENSES/LicenseRef-PlayStation-UI-Assets.txt. -->
    <AvaloniaResource Include="..\..\..\assets\icons\shell\*.png" Link="Assets/ShellIcons/%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\..\assets\branding\prosperismo.ico" Link="Assets/SharpEmu.ico" />
    <AvaloniaResource Include="..\..\..\assets\images\github.png" Link="Assets/github.png" />
    <AvaloniaResource Include="..\..\..\assets\images\discord.png" Link="Assets/discord.png" />
    <AvaloniaResource Include="..\..\..\assets\images\update-icon.png" Link="Assets/update-icon.png" />
    <AvaloniaResource Include="..\..\..\assets\images\commit-icon.png" Link="Assets/commit-icon.png" />
    <AvaloniaResource Include="..\..\..\assets\images\pic0.png" Link="Assets/pic0.png" />
    <!-- UI typeface: Fira Sans (SIL OFL 1.1), the open humanist sans closest to
         the PS5 shell's SST family. License: assets/fonts/FiraSans/OFL.txt. -->
    <AvaloniaResource Include="..\..\..\assets\fonts\FiraSans\*.ttf" Link="Assets/Fonts/%(Filename)%(Extension)" />

    <!-- Wordmark only, never body text: Bruno Ace (SIL OFL 1.1). The PS3 logo
         used the Spider-Man film face, which is Sony branding; this is the
         closest open stand-in for that angular, wedge-terminal look.
         License: assets/fonts/BrunoAce/OFL.txt. -->
    <AvaloniaResource Include="..\..\..\assets\fonts\BrunoAce\*.ttf" Link="Assets/Fonts/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Languages\*.json">
      <LogicalName>Languages.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Prosperismo.Shell.Runtime\Prosperismo.Shell.Runtime.csproj" />
  </ItemGroup>
</Project>
